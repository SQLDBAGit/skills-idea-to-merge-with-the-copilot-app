<section class="bookmark-manager" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Paste a link with or without <code>https://</code> to create a short <code>mona-</code> slug.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import { formatBookmark, loadBookmarks, normalizeUrl } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');
  let bookmarks = [];

  function showStatus(message) {
    if (status) status.textContent = message;
  }

  function readBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      showStatus('Browser storage is unavailable. Bookmarks will not persist.');
      return [];
    }
  }

  function renderBookmarks() {
    if (!list || !emptyState || !listHeader) return;

    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';
      separator.setAttribute('aria-hidden', 'true');

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      slug.setAttribute('aria-label', formatBookmark(bookmark));

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showStatus(`Copied ${bookmark.slug}.`);
        } catch {
          showStatus('Could not access the clipboard. Select the slug to copy it.');
        }
      });

      item.append(link, separator, slug, copy);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  function persistBookmarks() {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      return true;
    } catch {
      showStatus('Browser storage is unavailable. This bookmark may not persist.');
      return false;
    }
  }

  function createSlug() {
    const alphabet = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
    let slug;
    do {
      const bytes = new Uint8Array(4);
      crypto.getRandomValues(bytes);
      slug = `mona-${Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join('')}`;
    } while (bookmarks.some((bookmark) => bookmark.slug === slug));
    return slug;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(input instanceof HTMLInputElement) || !input.value.trim()) {
      showStatus('Enter a URL to save.');
      return;
    }

    let url;
    try {
      url = normalizeUrl(input.value);
    } catch {
      showStatus('Enter a valid http or https URL.');
      input.focus();
      return;
    }

    try {
      const bookmark = { url, slug: createSlug() };
      bookmarks.push(bookmark);
      const persisted = persistBookmarks();
      renderBookmarks();
      input.value = '';
      if (persisted) showStatus(`Saved ${formatBookmark(bookmark)}.`);
    } catch {
      showStatus('Could not add this bookmark. Please try again.');
    }
  });

  document.getElementById('clear-all')?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      window.localStorage.removeItem(storageKey);
    } catch {
      showStatus('Browser storage is unavailable. Saved data may still be present.');
    }
    renderBookmarks();
  });

  bookmarks = readBookmarks();
  renderBookmarks();
</script>

<style>
  .bookmark-manager {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.4);
    background: color-mix(in srgb, var(--accent) 5%, Canvas);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 8%, transparent);
  }

  .bookmark-manager form { margin-top: 0; }
  #list-header[hidden] { display: none; }
  .bookmark-manager input { background: Canvas; }
  .bookmark-manager form button { min-height: 2.75rem; }
  .hint { margin-bottom: 1rem; }
  .status { min-height: 1.25rem; margin: 0 0 0.75rem; color: var(--muted); font-size: 0.8rem; }
  .status:empty { display: none; }
  .bookmark-manager a { color: inherit; text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
  .bookmark .separator { color: var(--muted); white-space: pre; }
  .bookmark .slug { font-family: var(--font-body); }
  .bookmark-manager .empty { background: color-mix(in srgb, currentColor 2%, transparent); }

  @media (max-width: 34rem) {
    .bookmark-manager { padding: 1rem; }
    .bookmark-manager form button { width: 100%; }
  }
</style>
